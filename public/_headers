# Cloudflare serves static assets BEFORE invoking the Worker, so headers for
# these paths cannot be set in src/index.ts — that code only ever runs on a
# miss. This file is where they actually belong.

/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
  # Fonts are loaded by guides. and audit. via /brand/v1.css, which makes them
  # cross-origin. A font request is always CORS-mode regardless of the
  # crossorigin attribute on the tag, so without this the browser fetches the
  # file and then silently refuses to use it — the symptom is a subdomain that
  # falls back to a system face for no visible reason.
  Access-Control-Allow-Origin: *

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *
