{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bba-network-hub",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-15",

  // The workers.dev URL stays on until the custom domain is verified working.
  // Turning it off before then leaves no way to reach the Worker if the DNS
  // step goes wrong. See docs/DOMAINS.md.
  "workers_dev": true,

  // NOTE: there is deliberately no "routes" block. A routes entry makes the
  // deploy responsible for creating DNS records, and the deploy token does not
  // hold that permission — adding one here turns every deploy into a failure.
  // The apex is attached in the Cloudflare dashboard instead, once.

  // One scheduled check, not two, since 2026-08-26.
  //
  // Both moved here from GitHub Actions on 2026-08-24 when the deploy moved to
  // Workers Builds. `redirect-guard` has gone back, because it probes
  // https://bbanetwork.org — the hostname this Worker serves — and Cloudflare
  // answers 522 to a Worker's subrequest to its own route. It failed every one
  // of its nine probes every day and nothing reported it. It now runs from a
  // GitHub runner: .github/workflows/agent-redirect-guard.yml, still at 07:40
  // UTC.
  //
  // `link-warden` stays because its subject is other people's hostnames, which
  // a Worker reaches perfectly well.
  //
  // src/checks.ts says what the check covers; the mapping from expression to
  // check is in src/index.ts, and an expression added here without a matching
  // entry there logs that it ran nothing rather than silently doing nothing.
  "triggers": {
    "crons": ["20 7 * * *"]
  },

  "observability": { "enabled": true },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "kv_namespaces": [
    {
      // Aggregate outbound click counts. Nothing per-visitor is stored.
      "binding": "CLICKS",
      "id": "42574665e5314f62badd3e25002c7c78"
    }
  ]
}
